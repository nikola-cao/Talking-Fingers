rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own profile document.
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Per-term flashcard progress, one doc per Term raw value.
      match /cardProgress/{term} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // TODO: deny all reads once the OpenAI call moves behind a Cloud Function.
    // Until then the app fetches the key at launch, so signed-in users must
    // be able to read it. Writes are console/admin-only.
    match /API_KEYS/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
