rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own profile document.
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Per-term flashcard progress, one doc per Term raw value.
      match /cardProgress/{term} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Saved practices, one doc per practice UUID.
      match /practices/{practiceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Sentence generation is now on-device (Foundation Models) or a bundled
    // sentence bank — no API key is fetched or stored anymore.

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
